# GitHub API (Used by ci-mcp and git-mcp)
GITHUB_TOKEN=your_github_token_here

# Slack API (Used by slack-mcp)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Jira API (Used by issue-mcp)
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your_email@domain.com
JIRA_API_TOKEN=your_jira_api_token

# Grafana Tempo (Used by otel-mcp)
TEMPO_URL=http://your-tempo-instance:3200
TEMPO_API_TOKEN=your_tempo_token_if_needed

# Testkube (Used by k8s-test-mcp)
TESTKUBE_URL=https://api.testkube.io
TESTKUBE_API_TOKEN=your_testkube_token

# LLM Provider (Used by Orchestrator)
GEMINI_API_KEY=your_gemini_api_key
